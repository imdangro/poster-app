# =================================================================================================
#  Poster – configuration file. Copy it to .env (cp .env.example .env) or run
#  sudo bash scripts/init-nas.sh (it creates .env and generates the keys).
#  Rules: KEY=value, no spaces around "=", no quotes, comments only on separate lines.
#  After a change: sudo docker compose up -d
#  Bots (topic, sources, schedule, AI models, platforms), API keys and social media accounts
#  are set in the PANEL: http://NAS_IP:PANEL_PORT – not in this file.
#
#  Poster – plik konfiguracyjny. Skopiuj do .env (cp .env.example .env) albo uruchom
#  sudo bash scripts/init-nas.sh (utworzy .env i wygeneruje klucze).
#  Zasady: KLUCZ=wartość, bez spacji wokół "=", bez cudzysłowów, komentarze tylko w osobnych liniach.
#  Po zmianie: sudo docker compose up -d
#  Boty (temat, źródła, harmonogram, modele AI, platformy), klucze API i konta w mediach
#  społecznościowych ustawiasz w PANELU: http://NAS_IP:PANEL_PORT – nie w tym pliku.
# =================================================================================================

# ---------------------------------------------------------------- NAS / server – network · NAS / serwer – sieć
# IP address of the NAS or server in the LAN (best reserved in the router – DHCP reservation)
# Adres IP NAS-a lub serwera w sieci LAN (najlepiej zarezerwowany w routerze – DHCP reservation)
NAS_IP=192.168.1.50
# Bot control panel · Panel sterowania botami: http://NAS_IP:PANEL_PORT
PANEL_PORT=7080
# n8n (workflow engine · silnik workflow): http://NAS_IP:N8N_PORT
N8N_PORT=5678
# Host address the panel and n8n listen on: 0.0.0.0 = all IPv4 addresses (NAS in a home network).
# On a server on the internet (VPS) enter 127.0.0.1 and connect through an SSH tunnel or a VPN
# (README → “Remote access and servers on the internet”). The one-command installer does it on a public IP address.
# Na jakim adresie hosta nasłuchują panel i n8n: 0.0.0.0 = wszystkie adresy IPv4 (NAS w sieci domowej).
# Na serwerze w internecie (VPS) wpisz 127.0.0.1 i wchodź przez tunel SSH albo VPN
# (README.pl.md → „Dostęp spoza domu i serwer w internecie”). Instalator jednym poleceniem robi to przy publicznym IP.
BIND_ADDRESS=0.0.0.0
# Time zone: bot schedules and dates in posts · Strefa czasowa: harmonogram botów i daty w postach
TZ=Europe/Warsaw
# n8n image version (pinned – update deliberately) · Wersja obrazu n8n (przypięta – aktualizuj świadomie)
N8N_VERSION=2.40.7

# ---------------------------------------------------------------- Generated keys · Klucze generowane automatycznie
# scripts/init-nas.sh fills them in. NEVER change N8N_ENCRYPTION_KEY after the first start
# (you would lose access to the n8n data). PANEL_INTERNAL_TOKEN is the shared secret of the panel and n8n.
# scripts/init-nas.sh wypełni je sam. N8N_ENCRYPTION_KEY NIGDY nie zmieniaj po starcie
# (stracisz dostęp do danych n8n). PANEL_INTERNAL_TOKEN to wspólny sekret panelu i n8n.
N8N_ENCRYPTION_KEY=
PANEL_INTERNAL_TOKEN=

# ---------------------------------------------------------------- RSSHub (X profiles as RSS · profile X jako RSS)
# The "auth_token" cookie of a logged-in x.com session (use a SEPARATE account, not your main one!).
# Separate several tokens with commas – RSSHub spreads the requests. Needed when a bot follows X profiles.
# Ciasteczko "auth_token" z zalogowanej sesji x.com (użyj OSOBNEGO konta, nie głównego!).
# Kilka tokenów rozdziel przecinkami – RSSHub rozłoży zapytania. Potrzebne, gdy bot śledzi profile X.
TWITTER_AUTH_TOKEN=
# (Optional) a proxy for reading X only – the reader account then does not connect to X from your home IP.
# Format: socks5h://user:password@host:port or http://user:password@host:port. Choose a proxy with a FIXED IP
# (sticky), ideally residential/mobile – X blocks data center addresses most often. Empty = no proxy.
# After a change: sudo docker compose up -d rsshub
# (Opcjonalnie) proxy tylko dla odczytu X – konto-czytnik nie łączy się wtedy z X z domowego IP.
# Format: socks5h://user:haslo@host:port albo http://user:haslo@host:port. Wybierz proxy ze STAŁYM IP
# (sticky), najlepiej domowe/mobilne – adresy z centrów danych X blokuje najczęściej. Puste = bez proxy.
# Po zmianie: sudo docker compose up -d rsshub
RSSHUB_PROXY_URI=
# (Optional) RSSHub image version. "latest" by default, because RSSHub often fixes reading X.
# Enter a specific tag from hub.docker.com/r/diygod/rsshub to pin it.
# After a change: sudo docker compose pull rsshub && sudo docker compose up -d rsshub
# (Opcjonalnie) wersja obrazu RSSHub. Domyślnie "latest", bo RSSHub często poprawia odczyt X.
# Wpisz konkretny tag z hub.docker.com/r/diygod/rsshub, jeśli chcesz ją przypiąć.
# Po zmianie: sudo docker compose pull rsshub && sudo docker compose up -d rsshub
RSSHUB_VERSION=latest
